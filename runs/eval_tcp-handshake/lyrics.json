{
  "concept": "TCP 3-Way Handshake (SYN, SYN-ACK, ACK)",
  "bpm": 92,
  "time_signature": "4/4",
  "bars": [
    {
      "index": 1,
      "text": "The client fires a SYN to start the state,",
      "point_order": 1,
      "end_word": "state",
      "rhyme_group": "A",
      "key_terms_used": [
        "client",
        "SYN"
      ]
    },
    {
      "index": 2,
      "text": "Towards the listening port and open gate.",
      "point_order": 1,
      "end_word": "gate",
      "rhyme_group": "A",
      "key_terms_used": [
        "listening port"
      ]
    },
    {
      "index": 3,
      "text": "A random sequence number sets the pace,",
      "point_order": 1,
      "end_word": "pace",
      "rhyme_group": "B",
      "key_terms_used": [
        "sequence number"
      ]
    },
    {
      "index": 4,
      "text": "A glowing baton tossed across the space.",
      "point_order": 1,
      "end_word": "space",
      "rhyme_group": "B",
      "key_terms_used": []
    },
    {
      "index": 5,
      "text": "The server hears the call and locks the slot,",
      "point_order": 2,
      "end_word": "slot",
      "rhyme_group": "C",
      "key_terms_used": [
        "server"
      ]
    },
    {
      "index": 6,
      "text": "And sends a SYN-ACK back into the spot.",
      "point_order": 2,
      "end_word": "spot",
      "rhyme_group": "C",
      "key_terms_used": [
        "SYN-ACK"
      ]
    },
    {
      "index": 7,
      "text": "To increment by one and show the track,",
      "point_order": 2,
      "end_word": "track",
      "rhyme_group": "D",
      "key_terms_used": [
        "increment"
      ]
    },
    {
      "index": 8,
      "text": "The host will now acknowledge with its pack.",
      "point_order": 2,
      "end_word": "pack",
      "rhyme_group": "D",
      "key_terms_used": [
        "acknowledge"
      ]
    },
    {
      "index": 9,
      "text": "The final ACK will lock the bridge in place,",
      "point_order": 3,
      "end_word": "place",
      "rhyme_group": "E",
      "key_terms_used": [
        "ACK"
      ]
    },
    {
      "index": 10,
      "text": "ESTABLISHED is the state that both embrace.",
      "point_order": 3,
      "end_word": "embrace",
      "rhyme_group": "E",
      "key_terms_used": [
        "ESTABLISHED"
      ]
    },
    {
      "index": 11,
      "text": "One Round-Trip Time of wait to make it tight,",
      "point_order": 3,
      "end_word": "tight",
      "rhyme_group": "F",
      "key_terms_used": [
        "Round-Trip Time"
      ]
    },
    {
      "index": 12,
      "text": "Full-duplex trains now stream every byte.",
      "point_order": 3,
      "end_word": "byte",
      "rhyme_group": "F",
      "key_terms_used": [
        "full-duplex"
      ]
    }
  ]
}